# Autenticação
SECRET_PIN="1234"
AUTH_SECRET="gere-com-openssl-rand-base64-32"
AUTH_URL=https://seu-dominio.vercel.app
NEXTAUTH_URL=https://seu-dominio.vercel.app

# Spotify (obtenha em https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_client_secret_aqui
NEXT_PUBLIC_SPOTIFY_PLAYLIST_URI=spotify:playlist:37i9dQZF1DXcBWIGoYBM5M

# Mapbox (obtenha em https://account.mapbox.com)
# Configure restrições de URL no painel do Mapbox para o domínio da Vercel
MAPBOX_TOKEN=seu_token_aqui

# Cloudinary (obtenha em https://console.cloudinary.com/settings/api-keys)
CLOUDINARY_CLOUD_NAME=seu-cloud-name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=sua-api-secret

# Sentry (obtenha em https://claytonrssouza.sentry.io/settings/projects/our-journey/keys/)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
