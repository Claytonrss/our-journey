# Autenticação
SECRET_PIN="XXXX"
AUTH_SECRET="gere-com-openssl-rand-base64-32"
AUTH_URL=https://seu-dominio.vercel.app
NEXTAUTH_URL=https://seu-dominio.vercel.app

# Spotify (obtenha em https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_client_secret_aqui
NEXT_PUBLIC_SPOTIFY_PLAYLIST_URI=spotify:playlist:id_da_playlist

# Mapbox (obtenha em https://account.mapbox.com)
# Configure restrições de URL no painel do Mapbox para o domínio da Vercel
MAPBOX_TOKEN=seu_token_aqui
